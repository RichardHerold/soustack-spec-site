{
  "name": "soustack-spec-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync:spec": "node scripts/sync-spec.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "prepare:site": "npm run sync:spec && npm run generate:docs",
    "assert:artifacts": "node scripts/assert-artifacts.mjs",
    "dev": "npm run prepare:site && astro dev",
    "build": "npm run prepare:site && npm run assert:artifacts && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "^4.0.0",
    "@astrojs/mdx": "^3.0.0",
    "marked": "^11.0.0"
  },
  "soustackSpec": {
    "repo": "https://github.com/richardherold/soustack-spec.git",
    "ref": "main"
  }
}

