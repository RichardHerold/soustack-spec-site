---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { marked } from 'marked';

const specPath = join(process.cwd(), 'src', 'content', 'spec', 'SPEC.md');
let content = '';

if (existsSync(specPath)) {
  const specContent = readFileSync(specPath, 'utf-8');
  content = marked.parse(specContent);
} else {
  content = '<p><strong>Specification not found.</strong></p><p>Please run <code>npm run sync:spec</code> to sync the specification from the source repository.</p>';
}
---

<BaseLayout title="Specification - Soustack">
  <h1>Specification</h1>
  <Fragment set:html={content} />
</BaseLayout>

