---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

let registry = null;
try {
  const registryPath = join(process.cwd(), 'src', 'data', 'registry.generated.json');
  if (existsSync(registryPath)) {
    registry = JSON.parse(readFileSync(registryPath, 'utf-8'));
  }
} catch (err) {
  console.error('Failed to load registry:', err);
}
---

<BaseLayout title="Registry Debug - Soustack Specification">
  <h1>Registry Debug</h1>
  
  <div class="section">
    <p>This page displays the generated registry data used by the documentation site.</p>
    <p><a href="/stacks/registry.json">View source registry JSON</a></p>
  </div>
  
  {registry ? (
    <>
      <div class="section">
        <h2>Summary</h2>
        <ul>
          <li><strong>Profiles:</strong> {registry.profiles?.length || 0}</li>
          <li><strong>Stacks:</strong> {registry.stacks?.length || 0}</li>
          <li><strong>Generated At:</strong> {registry.generatedAt || 'Unknown'}</li>
        </ul>
      </div>
      
      <div class="section">
        <h2>Raw Registry Data</h2>
        <pre><code>{JSON.stringify(registry, null, 2)}</code></pre>
      </div>
    </>
  ) : (
    <div class="section">
      <p><em>Registry not found. Run <code>npm run generate:docs</code> to generate it.</em></p>
    </div>
  )}
</BaseLayout>

