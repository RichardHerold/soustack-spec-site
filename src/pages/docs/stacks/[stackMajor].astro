---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';
import { marked } from 'marked';

const { stackMajor } = Astro.params;

if (!stackMajor) {
  return Astro.redirect('/docs/stacks');
}

let registry = null;
let stack = null;
let markdownContent = null;

try {
  const registryPath = join(process.cwd(), 'src', 'data', 'registry.generated.json');
  if (existsSync(registryPath)) {
    registry = JSON.parse(readFileSync(registryPath, 'utf-8'));
    stack = registry.stacks?.find(s => s.docPath === `/docs/stacks/${stackMajor}`);
  }
} catch (err) {
  console.error('Failed to load registry:', err);
}

if (stack) {
  const markdownPath = join(process.cwd(), 'src', 'content', 'stacks', `${stackMajor}.md`);
  if (existsSync(markdownPath)) {
    const rawContent = readFileSync(markdownPath, 'utf-8');
    markdownContent = marked.parse(rawContent);
  }
}

export async function getStaticPaths() {
  try {
    const registryPath = join(process.cwd(), 'src', 'data', 'registry.generated.json');
    if (!existsSync(registryPath)) {
      return [];
    }
    
    const registry = JSON.parse(readFileSync(registryPath, 'utf-8'));
    const stacks = registry.stacks || [];
    
    return stacks.map((stack) => {
      // Construct stackMajor from stack data (e.g., "timed@1")
      const stackMajor = `${stack.id}@${stack.major}`;
      
      return {
        params: { stackMajor },
      };
    });
  } catch (err) {
    console.error('Error generating static paths:', err);
    return [];
  }
}

const title = stack ? `${stack.id}@${stack.major}` : stackMajor;
---

<BaseLayout title={`${title} - Soustack Specification`}>
  <h1>{title}</h1>
  
  {stack ? (
    <>
      {stack.description && (
        <div class="section">
          <p><strong>{stack.description}</strong></p>
        </div>
      )}
      
      {stack.dependsOn && stack.dependsOn.length > 0 && (
        <div class="section">
          <h2>Depends On</h2>
          <ul>
            {stack.dependsOn.map((dep) => (
              <li><code>{dep}</code></li>
            ))}
          </ul>
        </div>
      )}
      
      <div class="section">
        <h2>Resources</h2>
        <ul class="link-list">
          <li><a href={stack.schemaPath}>Schema</a></li>
          <li><a href="/docs/stacks">Back to Stacks Index</a></li>
        </ul>
      </div>
      
      {markdownContent ? (
        <div class="section">
          <h2>Documentation</h2>
          <Fragment set:html={markdownContent} />
        </div>
      ) : (
        <div class="section">
          <p><em>No documentation markdown found for {stackMajor}.</em></p>
        </div>
      )}
    </>
  ) : (
    <div class="section">
      <p>Stack not found: {stackMajor}</p>
      <p><a href="/docs/stacks">Back to Stacks Index</a></p>
    </div>
  )}
</BaseLayout>

