---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Soustack Specification' } = Astro.props;

// Determine if current page is the spec section
const currentPath = Astro.url.pathname;
const isSpecSection = currentPath.startsWith('/docs/spec');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="https://soustack.org" class="brand">
          <img src="/logo.png" alt="Soustack" />
          <span>soustack</span>
        </a>
        <a href="https://soustack.org/adoption">Adoption</a>
        <a href="https://soustack.org/concepts">Concepts</a>
        <a href="/docs/spec" class={isSpecSection ? 'current' : ''}>Spec</a>
        <a href="https://github.com/RichardHerold/soustack">Repo</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav>
        <a href="https://soustack.org">Back to Soustack.org</a>
        <a href="/URL-CONTRACT.md">URL Contract</a>
        <a href="https://github.com/RichardHerold/soustack-spec">GitHub</a>
      </nav>
    </footer>
  </body>
</html>

