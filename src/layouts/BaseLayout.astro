---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Soustack Specification' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/docs/spec">Spec</a>
        <a href="/docs/profiles">Profiles</a>
        <a href="/docs/stacks">Stacks</a>
        <a href="/docs/conformance">Conformance</a>
        <a href="/docs/discovery">Discovery</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

